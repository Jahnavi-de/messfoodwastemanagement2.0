# Copy to backend/.env and fill in. Without a .env file the defaults below match
# XAMPP's MySQL on a laptop (user root, no password).

# --- Database (MySQL / MariaDB: XAMPP on a laptop, apt on the Raspberry Pi, or a cloud database) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=nextjs_project
# Cloud databases (TiDB Cloud, Azure, Aiven ...) need an encrypted connection: set DB_SSL=true.
# DB_SSL=true
# Only if your provider gave you a certificate file to use instead:
# DB_SSL_CA=C:\path\to\ca.pem

# Example for TiDB Cloud Starter (values from the "Connect" button in the TiDB Cloud console):
# DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USER=xxxxxxxxxxxxxxx.root
# DB_PASS=the-password-you-generated
# DB_NAME=nextjs_project
# DB_SSL=true
# Keep these equal to the kitchen's time zone (and the Pi's).
DB_TIMEZONE=+05:30
APP_TIMEZONE=Asia/Kolkata

# --- Where this backend listens ---
HOST=0.0.0.0
PORT=8000

# --- ML API (Flask, ml-api/app.py) ---
ML_API_URL=http://127.0.0.1:5000

# --- Browser access: your frontend's address, or * to allow any ---
ALLOWED_ORIGIN=*

# --- Sensors ---
# Weight changes smaller than this (kg) are treated as scale noise.
SENSOR_NOISE_KG=0.05
# A Pi that hasn't uploaded for this many seconds is shown as offline.
DEVICE_OFFLINE_AFTER_S=180
