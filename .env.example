# Frontend settings (copy to .env.local). All requests go to the Python backend,
# which forwards ML requests to the ML API itself.
# Laptop: http://localhost:8000   Raspberry Pi: http://<pi-ip>:8000   Cloud: https://your-server

NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_ATTENDANCE_API_URL=http://localhost:8000/attendance
NEXT_PUBLIC_DASHBOARD_API_URL=http://localhost:8000/dashboard-data
NEXT_PUBLIC_WASTE_API_URL=http://localhost:8000/predict
NEXT_PUBLIC_PREDICTION_SAVE_URL=http://localhost:8000/save_prediction

# Optional overrides for the sensor endpoints (default: NEXT_PUBLIC_BACKEND_URL + /sensor_data, /prediction_context)
# NEXT_PUBLIC_SENSOR_API_URL=http://localhost:8000/sensor_data
# NEXT_PUBLIC_PREDICTION_CONTEXT_URL=http://localhost:8000/prediction_context
